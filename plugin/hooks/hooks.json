{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "timeout": 15, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook session" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook pre" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook post" }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook post" }]
      }
    ]
  }
}
