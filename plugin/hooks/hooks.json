{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "timeout": 15, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook session" },
          { "type": "command", "timeout": 60, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook notes" },
          { "type": "command", "timeout": 60, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook ledger" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "timeout": 60, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook precompact" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook pre" }]
      },
      {
        "matcher": "Agent",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook agent" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook post" }]
      },
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook ctx" }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "timeout": 10, "command": "S=\"$HOME/.local/bin/scaleout\"; [ -x \"$S\" ] || exit 0; exec \"$S\" hook post" }]
      }
    ]
  }
}
